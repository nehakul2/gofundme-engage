DATABASE_URL=postgres://postgres:postgres@localhost:5432/gofundme
REDIS_URL=redis://localhost:6379

# Shared secret the mock payment provider uses to sign webhooks
WEBHOOK_SECRET=dev-secret

# Where the mock provider posts its webhooks (leave empty to disable auto-delivery)
MOCK_PROVIDER_WEBHOOK_URL=http://localhost:3000/api/v1/payments/webhook
MOCK_PROVIDER_DELAY_MS=500
